@model IEnumerable<ProductCatalog.Models.Product>
@{
    ViewData["Title"] = "Products";
}

<div class="text-center">
    <h1 class="display-4">Products </h1>
    <p>List of available products.</p>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Description</th>
            <th>Price</th>
            <th>Actions</th>
		</tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.Id</td>
                <td>@product.Name</td>
                <td>@product.Description</td>
                <td>@product.Price</td>
				<td><a asp-controller="products"
                       asp-action="Details"
                       asp-route-id="@product.Id">Details</a></td>
            </tr>
        }
    </tbody>
</table>